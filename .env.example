# Leave a value empty to use the gateway default. Empty reads as "not set",
# which is what lets deploy/docker-compose.yml forward every variable without
# holding a second copy of the defaults.

LISTEN_ADDRESS=127.0.0.1:8080
# Required. Migrations run at startup, so a bad URL stops the process instead
# of letting it serve against a half-migrated schema.
DATABASE_URL=postgres://gateway:gateway-dev@127.0.0.1:15432/gateway
# Total gateway share of the Postgres connection ceiling, not a throughput dial.
# The admin pool is reserved from this total; the rest belongs to the data plane.
DATABASE_MAX_CONNECTIONS=10
ADMIN_DATABASE_MAX_CONNECTIONS=2
# Direct OpenAI-compatible upstream. Client credentials are never forwarded.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=replace-me
OPENAI_PROVIDER=openai
CODEX_AUTH_FILE=
CODEX_ACCOUNT_ID=
OPENAI_REQUEST_MAX_BYTES=33554432
# Direct Messages API upstream. This secret is injected server-side and never
# forwarded from a client request.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_PROVIDER=anthropic
ANTHROPIC_REQUEST_MAX_BYTES=33554432
# JSON array of gemini/xai/vllm/ollama server-side profiles. Store only the
# secret environment variable name here, never the secret itself.
EXTRA_PROVIDER_PROFILES_JSON=[]
# One decoded SSE event can contain a large tool result. Keep this configurable
# instead of silently truncating provider-compatible streams.
STREAM_EVENT_MAX_BYTES=33554432
# Maximum silence while waiting for provider headers or the next stream chunk.
PROVIDER_IDLE_TIMEOUT_MS=120000
# Maximum time for DNS/connect/TLS setup before a provider request fails.
PROVIDER_CONNECT_TIMEOUT_MS=10000
# Application headers above this aggregate byte count return 413. The HTTP/1
# parser has a separate fixed buffer at twice this size and returns 431 first.
REQUEST_HEADER_MAX_BYTES=65536
# SIGTERM rejects new data-plane work, then waits this long for active requests.
DRAIN_TIMEOUT_MS=30000
# Bounded wait for ledger and telemetry finalizers after connections close.
SHUTDOWN_FINALIZE_TIMEOUT_MS=5000
# Optional and accepted only in dev. Production must leave this unset.
ENABLE_DEVELOPMENT_BOOTSTRAP=true
BOOTSTRAP_CLIENT_KEY=apg_dev_replace-me
# HMAC key for virtual credentials. Production supplies this from its secret provider.
CREDENTIAL_HASH_KEY=replace-with-at-least-32-random-bytes
CREDENTIAL_HASH_KEY_ID=v1
# During server-key rotation: old-v1=at-least-32-bytes,older-v0=at-least-32-bytes
CREDENTIAL_RETIRING_HASH_KEYS=
CREDENTIAL_ENVIRONMENT=dev
CREDENTIAL_CACHE_CAPACITY=1024
CREDENTIAL_CACHE_TTL_SECONDS=60
POLICY_CACHE_CAPACITY=1024
POLICY_CACHE_TTL_SECONDS=60
# Optional one-shot control-plane bootstrap. Configure both values together;
# leave both empty after the first admin account has been created.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_TENANT_ID=
ADMIN_SESSION_TTL_SECONDS=900
# Exact browser origin. HTTP is accepted only for a loopback origin in dev.
ADMIN_ALLOWED_ORIGIN=http://127.0.0.1:5173
# Comma-separated proxy IPs allowed to supply X-Forwarded-For.
ADMIN_TRUSTED_PROXY_IPS=
# Nil-tenant development bootstrap only. Production tenants use the active DB registry.
ALLOWED_MODELS=company-default,company-fast,company-reasoning
# Required outside the development bootstrap. Only these tenants may use the
# server-side provider credentials, even if an Admin creates a matching row.
PROVIDER_ALLOWED_TENANT_IDS=
# Passive pre-call routing. A logical request still makes exactly one upstream call.
ROUTING_HEALTH_AWARE=true
ROUTING_LOAD_AWARE=true
ROUTING_COST_AWARE=false
ROUTING_QUOTA_AWARE=true
ROUTING_AUTO_QUALITY=true
ROUTING_FAILURE_COOLDOWN_MS=30000
# Durable metadata-only outbox. Capacity is reserved before an upstream call.
LEDGER_SPOOL_DIR=var/ledger-spool
LEDGER_SPOOL_MAX_BYTES=67108864
LEDGER_SPOOL_ENTRY_MAX_BYTES=32768
# Bounded single-process scheduler. The three active pools total 20 slots;
# workload families cannot borrow each other's reserved slots.
SCHEDULER_ACTIVE_INTERACTIVE_RESERVED=12
SCHEDULER_PASSTHROUGH=false
SCHEDULER_ACTIVE_SHARED=4
SCHEDULER_ACTIVE_BACKGROUND_RESERVED=4
SCHEDULER_QUEUE_INTERACTIVE_RESERVED=64
SCHEDULER_QUEUE_SHARED=128
SCHEDULER_QUEUE_BACKGROUND_RESERVED=64
SCHEDULER_QUEUE_PER_TENANT=64
SCHEDULER_QUEUE_PER_CREDENTIAL=32
SCHEDULER_PER_PROVIDER=20
SCHEDULER_PER_MODEL=20
SCHEDULER_PER_USER=8
SCHEDULER_PER_DEVICE=8
SCHEDULER_PER_CLIENT=8
SCHEDULER_PER_AGENT=8
SCHEDULER_PER_CREDENTIAL=8
SCHEDULER_PER_WORKLOAD=20
SCHEDULER_HARD_QUEUE_TIMEOUT_MS=30000
SCHEDULER_AGING_INTERVAL_MS=1000
# Test-only negative-control switches. Production keeps both enabled.
SCHEDULER_AGING_ENABLED=true
SCHEDULER_RESERVATIONS_ENABLED=true
# Absent is fine: the binary defaults to info plus warn for the exporter.
# If you set this, keep the exporter directives or its failures go unseen.
RUST_LOG=info,opentelemetry_sdk=warn,opentelemetry_otlp=warn

# Enabled quality requests send content to TypeSafe; explicit model IDs do not.
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_MODEL_DESCRIPTIONS_JSON={}
